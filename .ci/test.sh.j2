deselect=()
for t in "${broken_gridspec[@]}"; do deselect+=(--deselect "$t"); done
python -m pytest -n8 "${deselect[@]}" || python -m pytest --last-failed --last-failed-no-failures none "${deselect[@]}"
{% endblock %}
