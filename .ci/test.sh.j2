{% extends "ci-infrastructure/python-runner.sh.j2" %}
{% block set_environment %}
# findlibs finds eccodes, odc, metkit, and fdb from their *_HOME; each dep has its own prefix.
IFS=';:' read -ra dep_prefixes <<<"${CMAKE_PREFIX_PATH:-}"
for prefix in ${dep_prefixes[@]+"${dep_prefixes[@]}"}; do
  if compgen -G "$prefix/lib*/libeccodes.*" >/dev/null; then
    export ECCODES_HOME="$prefix"
    export ECCODES_DEFINITION_PATH="$prefix/share/eccodes/definitions"
    export ECCODES_SAMPLES_PATH="$prefix/share/eccodes/samples"
  fi
  if compgen -G "$prefix/lib*/libodccore.*" >/dev/null; then
    export ODC_HOME="$prefix"
  fi
  if compgen -G "$prefix/lib*/libmetkit.*" >/dev/null; then
    export METKIT_HOME="$prefix"
  fi
  if compgen -G "$prefix/lib*/libfdb5.*" >/dev/null; then
    export FDB5_HOME="$prefix"
  fi
done
# mir-python from PyPI loads mirlib and its deps through findlibs' package lookup.
export FINDLIBS_DISABLE_PACKAGE=no
export EARTHKIT_DATA_CACHE_POLICY=off
export UV_PRERELEASE=allow
{% endblock %}
{% block test %}
cd "$CI_SOURCE_DIR"
# TEMPORARY: the released mir and eckit wheels do not support projected and rotated gridspecs (regular_xy); re-enable once they pass.
broken_gridspec=(
  "tests/regrid/regrid_backends/test_matrix_xarray.py::test_regrid_matrix_xarray_projected_input_no_weights"
  "tests/regrid/regrid_mir/test_mir_grid.py::test_mir_backend_grid_spec_passthrough"
  "tests/regrid/regrid_mir/test_mir_grid.py::test_regrid_array_projected_input_to_ll"
  "tests/regrid/regrid_mir/test_regrid_xarray.py::test_regrid_xarray_laea_dataset_to_ll"
  "tests/regrid/regrid_mir/test_regrid_xarray.py::test_regrid_xarray_projected_explicit_grid_transposed_dims"
  "tests/regrid/regrid_mir/test_regrid_xarray.py::test_regrid_xarray_rotated_explicit_outer_order_grid_transposed_dims"
  "tests/regrid/regrid_mir/test_regrid_xarray.py::test_regrid_xarray_cordex_rotated_ll_to_ll"
  "tests/regrid/regrid_mir/test_regrid_xarray.py::test_regrid_xarray_dask_from_sample[rotated-ll]"
  "tests/regrid/regrid_mir/test_regrid_xarray.py::test_regrid_xarray_rotated_out_grid_default_out_dims"
  "tests/regrid/regrid_mir/test_regrid_xarray.py::test_regrid_xarray_rotated_out_grid_default_out_dims_lazy"
