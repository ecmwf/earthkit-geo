  "tests/test_sphinxext_catalogue.py::test_installed_catalogues"
  "tests/xarray_grid/test_xarray_grid.py::test_xarray_grid_projected_xy"
  "tests/xarray_grid/test_xarray_grid.py::test_xarray_grid_projected_grid_mapping_per_variable[False]"
  "tests/xarray_grid/test_xarray_grid.py::test_xarray_grid_projected_grid_mapping_per_variable[True]"
